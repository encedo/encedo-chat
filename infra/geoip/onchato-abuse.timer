# Daily, shortly after midnight UTC: `until=2026-11-10` means blocked through
# that day, and this is what makes it stop the day after.
[Unit]
Description=onchato abuse block list rebuild, daily

[Timer]
OnCalendar=*-*-* 00:10:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
