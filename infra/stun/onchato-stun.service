# systemd — onchato STUN (encedo-chat/infra/stun)
# Install:  sudo cp onchato-stun.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now onchato-stun
# Logs:     sudo journalctl -u onchato-stun -f
# Firewall: sudo ufw allow 3478/udp   <- the ONLY port this opens; nothing proxies UDP
#
# Runs on every relay node: clients hold a WSS connection to these hosts already,
# so asking them "what address do you see?" tells the operator nothing new.

[Unit]
Description=onchato STUN (encedo-chat) — Binding Request only, no TURN
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/github/encedo-chat/infra/stun
ExecStart=/usr/bin/node stun.mjs
Environment=NODE_ENV=production
Restart=always
RestartSec=5
# It answers datagrams and writes a stats line every five minutes. Nothing else
# is needed, so nothing else is allowed.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=
# WARNING: AF_UNIX and AF_NETLINK are not decoration: libuv uses socketpairs for its
# own wakeups and netlink to enumerate interfaces, so a list of just AF_INET*
# stops Node from starting at all — with an error that blames neither.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=128M

[Install]
WantedBy=multi-user.target
