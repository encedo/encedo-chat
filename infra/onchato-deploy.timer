# Every five minutes, and five is not an accident: a release is a deliberate act
# that somebody is waiting on, and a shorter interval buys seconds at the cost
# of a git fetch against GitHub all day.
[Unit]
Description=onchato — look for a new release tag

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
# The interval is monotonic, counted from the START of the last run (not the
# clock's whole minutes), so the ticks drift and a run that builds for minutes
# still starts the next one five minutes after its own start. Persistent only
# matters for OnCalendar timers; kept false so it says what is meant: a host
# that was off does not fire a backlog.
Persistent=false
AccuracySec=30s

[Install]
WantedBy=timers.target
