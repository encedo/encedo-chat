# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# webpack's filesystem cache — outside node_modules on purpose, so that
# `npm ci` (which wipes node_modules) does not throw it away on every deploy
.webpack-cache/

# logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# local env / secrets
.env
.env.local
*.local

# test-only software keystores (contain private keys — never commit)
*.keystore.json

# local per-user CLI config (hsm url / kid pointers)
*.local.json
