# /etc/systemd/system/onchato-bot.service - GUIDE.md
[Unit]
Description=onchato-bot: polecenia z czatu i pukanie do adminow
After=docker.service
Wants=docker.service

[Service]
ExecStart=/usr/bin/python3 -I /opt/onchato-bot/onchato-bot.py --config /etc/onchato/bot.json serve
# The daemon restarting ends the event stream; come back when it is up again.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
