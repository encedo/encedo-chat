{
  "_opis": "Przyklad - GUIDE.md. admins: odciski kluczy (onchato-cli contacts), nie nazwy. Argument tylko jako caly element run, z regexem w args.",
  "socket": "/srv/onchato/onchato.sock",
  "name": "serwer1",
  "admins": ["00:00:00:00:00:00:00:00"],
  "answer": "contacts",
  "rate_seconds": 10,
  "timeout_seconds": 20,
  "reports": { "to": ["ja"], "ttl": "7d" },
  "commands": {
    "ping":   { "run": ["echo", "pong"] },
    "uptime": { "run": ["uptime"] },
    "dysk":   { "run": ["df", "-h", "/"] },
    "pamiec": { "run": ["free", "-m"] },
    "docker": { "run": ["docker", "ps", "--format", "{{.Names}}  {{.Status}}"], "admin": true },
    "logi":   { "run": ["journalctl", "-u", "{unit}", "-n", "20", "--no-pager"],
                "args": { "unit": "^(nginx|ssh|docker)$" }, "admin": true }
  }
}
