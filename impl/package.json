{
  "name": "encedo-chat-spike",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "v6 TS spike — rendezvous spine on the v5 libp2p base. Crypto handshake (EH-2/ratchet) held pending cryptographer review.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "meet": "node net/meet.ts",
    "chat-test": "node net/chat-test.ts",
    "eh2-test": "node net/eh2-chat-test.ts",
    "gui-sim": "node net/gui-sim.ts",
    "bob": "node bob/bob.ts",
    "carl": "node carl/carl.ts",
    "alice": "node alice/alice.ts",
    "ec": "node cli/ec.ts",
    "web:build": "webpack --config web/webpack.config.cjs --mode production",
    "web:dev": "webpack serve --config web/webpack.config.cjs --mode development",
    "room-sim": "node net/room-sim.ts",
    "browser-test": "node net/browser-test.ts",
    "browser-test:ff": "BROWSERS=chromium,firefox node net/browser-test.ts"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.0.0",
    "@chainsafe/libp2p-yamux": "^7.0.0",
    "@libp2p/circuit-relay-v2": "^3.1.0",
    "@libp2p/crypto": "^5.0.6",
    "@libp2p/identify": "^3.0.12",
    "@libp2p/peer-id": "^5.0.9",
    "@libp2p/websockets": "^9.0.13",
    "@multiformats/multiaddr": "^12.3.4",
    "@noble/post-quantum": "^0.6.1",
    "libp2p": "^2.2.1",
    "uint8arrays": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-block-scoping": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "babel-loader": "^10.1.1",
    "html-webpack-plugin": "^5.6.7",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
