{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "onchato",
  "version": "0.3.10",
  "identifier": "com.onchato.chat",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run web:build",
    "beforeDevCommand": "npm run web:dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "onchato",
        "width": 1100,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ]
      }
    },
    "category": "SocialNetworking",
    "shortDescription": "onchato \u2014 P2P messenger",
    "longDescription": "Minimal-infrastructure P2P messenger (v6): HEM identity, EH-2 + Double Ratchet, WebRTC direct plane with a relay fallback. This desktop shell wraps the same web bundle in a native window; all crypto and transport run in the webview.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
