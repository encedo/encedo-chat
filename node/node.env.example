# One onchato node. onchato-setup.sh writes this file; by hand: copy it to
# node.env and fill in the first block.

# --- what every node needs ---
NODE_HOST=n1.example.com          # the node's public name (DNS A/AAAA record -> this machine)
ACME_EMAIL=it@example.com         # Let's Encrypt writes here before a certificate lapses
HOME_URL=https://example.com/     # where a browser that opens the node's name is sent

# --- defaults that fit a 1-2 vCPU machine (measured: ~400 people) ---
MAX_CONNS=400
# MAX_TOPICS=1600                 # default 4 x MAX_CONNS
REDIS_PORT=6379                   # statistics, 30 days, loopback only (drop it and 'stats' below for none)
COMPOSE_PROFILES=stats            # stats: Redis; add ,store for the file store (STORE=here)

# --- more than one node: the mesh over IPv6 port 9002 ---
# V6_HOST=2001:db8::10            # this node's IPv6
# PEERS=/ip6/2001:db8::20/tcp/9002/ws/p2p/12D3KooW...   # every OTHER node, space-separated
# SIBLINGS=12D3KooW...,12D3KooW...                      # their PeerIds

# --- a test box without public DNS ---
# CERT_MODE=self                  # self-signed: curl -k works, the apps refuse it
# CERT_MODE=staging               # Let's Encrypt's test CA, for a machine rebuilt often (5 real certs/name/week)
